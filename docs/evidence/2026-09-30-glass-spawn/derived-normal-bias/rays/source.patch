+#ifdef HORDE_RT_REMAINING_VOLUME_PROBE
+int investigationVolumeTarget()
+{
+    uvec2 pixel = HORDE_RT_PIXEL_ID.xy;
+    if (pixel == uvec2(515u, 569u)) return 0;
+    if (pixel == uvec2(515u, 570u)) return 1;
+    return -1;
+}
+// Lossless float bytes occupy two RGB pixels. First68 fields reuse the existing
+// 136-pixel slot layout; supplementary fields use another row, never a buffer.
+void investigationWriteFloat(int slot, int field, float value)
+{
+    int target = investigationVolumeTarget();
+    if (target < 0) return;
+    int row = target;
+    int column = slot * 136 + field * 2;
+    if (field >= 68) { row += 2; column = slot * 48 + (field - 68) * 2; }
+    uint bits = floatBitsToUint(value);
+    vec3 low = vec3(uvec3(bits & 255u, (bits >> 8) & 255u, (bits >> 16) & 255u)) / 255.0;
+    vec3 high = vec3(float(bits >> 24) / 255.0, 0.0, 0.0);
+    if (controls.outputRedBlueSwap > 0.5) { low = low.bgr; high = high.bgr; }
+    imageStore(outputImage, ivec2(column, row), vec4(low, 1.0));
+    imageStore(outputImage, ivec2(column + 1, row), vec4(high, 1.0));
+}
+void investigationVolumeInterface(int slot, HitInfo hit, vec3 direction,
+    bool open, int tir, float distance, vec3 throughput, uint instance,
+    uint material, float ior, bool certified)
+{
+    float fields[29] = float[29](hit.position.x, hit.position.y, hit.position.z,
+        hit.geometricNormal.x, hit.geometricNormal.y, hit.geometricNormal.z,
+        direction.x, direction.y, direction.z, hit.t, float(hit.instance),
+        float(hit.material), float(hit.primitive), open ? 1.0 : 0.0,
+        hit.hit ? 1.0 : 0.0, float(tir), distance, hit.roughness, hit.ior,
+        hit.attenuationDistance, throughput.x, throughput.y, throughput.z,
+        float(hit.materialFlags), hit.transmission, float(instance), float(material),
+        ior, certified ? 1.0 : 0.0);
+    for (int i = 0; i < 29; ++i) investigationWriteFloat(slot, i, fields[i]);
+    float geometry[21] = float[21](hit.investigationV0.x, hit.investigationV0.y, hit.investigationV0.z,
+        hit.investigationV1.x, hit.investigationV1.y, hit.investigationV1.z,
+        hit.investigationV2.x, hit.investigationV2.y, hit.investigationV2.z,
+        hit.investigationTransform[0].x, hit.investigationTransform[0].y, hit.investigationTransform[0].z,
+        hit.investigationTransform[1].x, hit.investigationTransform[1].y, hit.investigationTransform[1].z,
+        hit.investigationTransform[2].x, hit.investigationTransform[2].y, hit.investigationTransform[2].z,
+        hit.investigationTransform[3].x, hit.investigationTransform[3].y, hit.investigationTransform[3].z);
+    for (int i = 0; i < 21; ++i) investigationWriteFloat(slot, 37 + i, geometry[i]);
+    for (int axis = 0; axis < 3; ++axis)
+    {
+        investigationWriteFloat(slot, 58 + axis, hit.investigationObjectOrigin[axis]);
+        investigationWriteFloat(slot, 61 + axis, hit.investigationObjectDirection[axis]);
+        investigationWriteFloat(slot, 65 + axis, hit.dielectricSpawnPosition[axis]);
+        investigationWriteFloat(slot, 69 + axis, hit.investigationQueryOrigin[axis]);
+        investigationWriteFloat(slot, 72 + axis, hit.investigationQueryDirection[axis]);
+    }
+    investigationWriteFloat(slot, 64, hit.dielectricSpawnGuarded ? 1.0 : 0.0);
+    investigationWriteFloat(slot, 68, hit.investigationQueryMinimum);
+    investigationWriteFloat(slot, 75, hit.investigationMinimumWidth);
+    investigationWriteFloat(slot, 76, hit.investigationGeometryError);
+    investigationWriteFloat(slot, 77, hit.investigationBary.x);
+    investigationWriteFloat(slot, 78, hit.investigationBary.y);
+    investigationWriteFloat(slot, 79, (hit.materialFlags & kRtMaterialFlagCertifiedRectangularVolume) != 0u ? 1.0 : 0.0);
+    investigationWriteFloat(slot, 81, hit.investigationRawT);
+    investigationWriteFloat(slot, 82, float(hit.investigationGeometryIndex));
+}
+#endif
