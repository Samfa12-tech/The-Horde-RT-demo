+// Caller has successfully waited this slot's fence or the entire device.
+// Never reconstruct identity/zone from a later mutable scene snapshot.
+void CollectOpeningProbe(SwapchainContext& context, const std::uint32_t frameSlot)
+{
+    auto& pending = context.openingProbePending[frameSlot];
+    if (!pending.pending) return;
+    const auto emit = [&](const char* stage, horde::vulkan::GpuFrameTimer& timer,
+                          const bool submitted) {
+        const auto result = submitted ? timer.CollectCompleted(frameSlot)
+                                     : horde::vulkan::GpuFrameTimingCollection{};
+        const bool joined = result.consumed && result.submissionSequence ==
+            pending.identity.submissionSerial && result.frameSlot == frameSlot;
+        const bool valid = joined && result.hasSample && result.status ==
+            horde::vulkan::GpuFrameTimingCollectionStatus::Valid;
+        const auto& f = pending.identity.frame;
+        __android_log_print(ANDROID_LOG_INFO, kTag,
+            "OPENING_GPU_STAGE stage=%s epoch=%llu generation=%llu attempt=%llu record=%llu tick=%llu slot=%u submission=%llu submitted=%d joined=%d valid=%d ms=%.9f status=%d vk=%d timer=%s",
+            stage, static_cast<unsigned long long>(f.sceneEpoch),
+            static_cast<unsigned long long>(f.measurementGeneration),
+            static_cast<unsigned long long>(f.recordAttemptSerial),
+            static_cast<unsigned long long>(f.recordSerial),
+            static_cast<unsigned long long>(f.simulationTick), frameSlot,
+            static_cast<unsigned long long>(pending.identity.submissionSerial),
+            submitted, joined, valid, valid ? result.sample.milliseconds : -1.0,
+            static_cast<int>(result.status), static_cast<int>(result.result),
+            horde::vulkan::GpuFrameTimerStatusName(timer.Telemetry().status));
+    };
+    emit("geometry-as", context.openingGeometryTimer, pending.geometrySubmitted);
+    emit("rt-dispatch", context.openingDispatchTimer, pending.dispatchSubmitted);
+    pending = {};
