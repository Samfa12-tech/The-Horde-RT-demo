diff --git a/shaders/raytracing/include/rt_scene_abi.glsl b/shaders/raytracing/include/rt_scene_abi.glsl
index 0dfa1b2..ff96c4e 100644
--- a/shaders/raytracing/include/rt_scene_abi.glsl
+++ b/shaders/raytracing/include/rt_scene_abi.glsl
@@ -108,6 +108,46 @@ struct HitInfo
     uint materialFlags;
 };
 
+// Local investigation only; remove before production regeneration.
+#if defined(HORDE_RT_VARIANT_INSTRUMENTATION) && HORDE_RT_VARIANT_INSTRUMENTATION == HORDE_RT_INSTRUMENTATION_DIAGNOSTIC && HORDE_RT_VARIANT_MATERIAL == HORDE_RT_MATERIAL_GENERIC_DIELECTRIC
+#define HORDE_RT_GLASS_RECOVERY_PROBE
+vec3 investigationGlassRecovery = vec3(0.0);
+vec3 investigationBarycentricPosition = vec3(0.0);
+int investigationRecoveryTarget()
+{
+    uvec2 pixel = HORDE_RT_PIXEL_ID.xy;
+    if (pixel == uvec2(346u, 1200u)) return 0;
+    if (pixel == uvec2(340u, 1046u)) return 1;
+    if (pixel == uvec2(638u, 1216u)) return 2;
+    if (pixel == uvec2(193u, 1537u)) return 3;
+    if (pixel == uvec2(427u, 1520u)) return 4;
+    if (pixel == uvec2(328u, 842u)) return 5;
+    return -1;
+}
+void investigationRecordRecoveryInterface(int slot, HitInfo hit, vec3 direction,
+    bool open, int tirCount, float totalDistance, vec3 throughput)
+{
+    int target = investigationRecoveryTarget();
+    if (target < 0) return;
+    float fields[25] = float[25](hit.position.x, hit.position.y, hit.position.z,
+        hit.geometricNormal.x, hit.geometricNormal.y, hit.geometricNormal.z,
+        direction.x, direction.y, direction.z, hit.t, float(hit.instance),
+        float(hit.material), float(hit.primitive), open ? 1.0 : 0.0,
+        hit.hit ? 1.0 : 0.0, float(tirCount), totalDistance, hit.roughness,
+        hit.ior, hit.attenuationDistance, throughput.x, throughput.y, throughput.z,
+        float(hit.materialFlags), hit.transmission);
+    for (int i = 0; i < 25; ++i)
+    {
+        uint bits = floatBitsToUint(fields[i]);
+        vec3 low = vec3(uvec3(bits & 255u, (bits >> 8) & 255u, (bits >> 16) & 255u)) / 255.0;
+        vec3 high = vec3(float(bits >> 24) / 255.0, 0.0, 0.0);
+        if (controls.outputRedBlueSwap > 0.5) { low = low.bgr; high = high.bgr; }
+        imageStore(outputImage, ivec2(slot * 50 + i * 2, target), vec4(low, 1.0));
+        imageStore(outputImage, ivec2(slot * 50 + i * 2 + 1, target), vec4(high, 1.0));
+    }
+}
+#endif
+
