diff --git a/android/app/src/main/cpp/android_probe_bridge.cpp b/android/app/src/main/cpp/android_probe_bridge.cpp
index a4486bd..a25c326 100644
--- a/android/app/src/main/cpp/android_probe_bridge.cpp
+++ b/android/app/src/main/cpp/android_probe_bridge.cpp
@@ -3099,6 +3099,35 @@ bool RenderFrame(SwapchainContext& context, bool& rtFramePresented)
         ++context.capturePresentedFrames;
         if (context.capturePresentedFrames == 12u)
         {
+#if defined(HORDE_RT_DEBUG_CHECKPOINTS)
+            // Temporary isolated-glass investigation, not a production readback
+            // route or performance sample. Preserve native bytes before Android
+            // presentation scaling and join the same completed frame packet.
+            if (context.activeBenchmarkName == "lantern-glass-production")
+            {
+                horde::vulkan::raytracing::PresentableTinyRtScene::StorageImageCapture raw;
+                std::string rawDiagnostic;
+                const VkResult idle = vkDeviceWaitIdle(context.device);
+                if (idle == VK_SUCCESS && CompleteRtEvidenceAfterDeviceIdle(context, idle) &&
+                    context.rtScene.CaptureStorageImage(raw, rawDiagnostic))
+                {
+                    std::ofstream output(context.reportDirectory + "/isolated-transport.rgba",
+                                         std::ios::binary);
+                    output.write(reinterpret_cast<const char*>(&raw.width), sizeof(raw.width));
+                    output.write(reinterpret_cast<const char*>(&raw.height), sizeof(raw.height));
+                    output.write(reinterpret_cast<const char*>(raw.rgba.data()),
+                                 static_cast<std::streamsize>(raw.rgba.size()));
+                    output.flush();
+                    __android_log_print(output.good() ? ANDROID_LOG_INFO : ANDROID_LOG_ERROR,
+                        kTag, "HORDE_ISOLATED_RAW_CAPTURE width=%u height=%u bytes=%zu written=%d",
+                        raw.width, raw.height, raw.rgba.size(), output.good() ? 1 : 0);
+                }
+                else
+                    __android_log_print(ANDROID_LOG_ERROR, kTag,
+                        "HORDE_ISOLATED_RAW_CAPTURE failed idle=%d diagnostic=%s",
+                        static_cast<int>(idle), rawDiagnostic.c_str());
+            }
+#endif
             WriteShowcaseDebugState(context, "capture-ready");
             __android_log_print(ANDROID_LOG_INFO,
                                 kTag,
