+                    output.write(reinterpret_cast<const char*>(&raw.width), sizeof(raw.width));
+                    output.write(reinterpret_cast<const char*>(&raw.height), sizeof(raw.height));
+                    output.write(reinterpret_cast<const char*>(raw.rgba.data()),
+                                 static_cast<std::streamsize>(raw.rgba.size()));
+                    output.flush();
+                    __android_log_print(output.good() ? ANDROID_LOG_INFO : ANDROID_LOG_ERROR,
+                        kTag, "HORDE_ISOLATED_RAW_CAPTURE width=%u height=%u bytes=%zu written=%d",
+                        raw.width, raw.height, raw.rgba.size(), output.good() ? 1 : 0);
+                }
+                else
+                    __android_log_print(ANDROID_LOG_ERROR, kTag,
+                        "HORDE_ISOLATED_RAW_CAPTURE failed idle=%d diagnostic=%s",
+                        static_cast<int>(idle), rawDiagnostic.c_str());
+            }
+#endif
