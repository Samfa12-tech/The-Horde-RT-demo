@@ -0,0 +1,43 @@
+// One bounded smoke medium, independent of flame, light admission and Mist.
+// This density-only path makes no RT or lighting calls, including in shadows.
+bool boundedSmokeSegment(vec3 origin,vec3 direction,float limit,out float a,out float b)
+{
+    if(rtQualityControls.smoke.identity.x==0u || limit<=0.0 || isnan(limit))return false;
+    if(!rayBoxInterval(origin,direction,rtQualityControls.smoke.boundsMinExtinction.xyz,
+        rtQualityControls.smoke.boundsMaxReserved.xyz,a,b))return false;
+    a=max(a,0.0);b=min(b,limit);return b>a;
+}
+float boundedSmokeDensity(vec3 p)
+{
+    RtSmokeMediumGpu m=rtQualityControls.smoke;
+    float height=m.boundsMaxReserved.y-m.outletRadius.y;
+    float y=p.y-m.outletRadius.y;
+    float h=clamp(y/height,0.0,1.0);
+    float time=controls.time;
+    vec2 flow=m.flowShape.xy*y/m.flowShape.z;
+    vec2 sway=vec2(sin(y*1.17-time*.32+float(m.identity.x)*.31),
+                    cos(y*.93-time*.27))*h*.3;
+    vec2 q=p.xz-m.outletRadius.xz-flow-sway;
+    float radius=mix(m.outletRadius.w,m.flowShape.w,h)*
+        (.87+.13*sin(y*1.6-time*.72));
+    float radial=length(q)/max(radius,.001);
+    float edge=1.0-smoothstep(.55,1.0,radial);
