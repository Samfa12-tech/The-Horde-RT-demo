+// Actual RT source visibility, with bounded per-interval anchor reuse.
+vec3 boundedSmokeSky(vec3 p,vec3 viewDirection)
+{
+    vec3 direction,radiance;float distance,gain;
+    activeSkyLight(p,areaShadowSampleIndex(),direction,distance,radiance,gain);
+    if(gain<=0.0 || isnan(gain) || isinf(gain))return vec3(0.0);
+    vec3 visibility=sceneShadowTransmittanceMask(p,direction,max(distance-.02,.004),0x35u);
+    float g=rtQualityControls.smoke.albedoAnisotropy.w;
+    float cosine=clamp(dot(-viewDirection,direction),-1.0,1.0);
+    float phase=(1.0-g*g)/(12.5663706*pow(max(1.0+g*g-2.0*g*cosine,.001),1.5));
+    return max(radiance,vec3(0.0))*gain*visibility*phase;
+}
+vec4 integrateBoundedSmoke(vec3 origin,vec3 direction,float limit,bool secondary)
+{
+    float a,b;if(!boundedSmokeSegment(origin,direction,limit,a,b))return vec4(0,0,0,1);
+    bool high=rtQualityControls.smoke.identity.y==2u;
+    int samples=secondary?(high?4:2):(high?8:4);
+    float ds=(b-a)/float(samples);
+    vec3 first=boundedSmokeSky(origin+direction*mix(a,b,high?.25:.5),direction);
+    vec3 second=high?boundedSmokeSky(origin+direction*mix(a,b,.75),direction):first;
+    vec3 radiance=vec3(0);float transmission=1.0;
+    for(int i=0;i<8;++i) {
+        if(i>=samples)break;
+        float t=(float(i)+.5)/float(samples);
+        vec3 p=origin+direction*(a+t*(b-a));
+        float sigma=rtQualityControls.smoke.boundsMinExtinction.w*boundedSmokeDensity(p);
+        float alpha=1.0-exp(-sigma*ds);
+        vec3 incident=mix(first,second,high?clamp((t-.25)*2.0,0.0,1.0):0.0);
+        radiance+=transmission*incident*rtQualityControls.smoke.albedoAnisotropy.rgb*alpha;
+        transmission*=1.0-alpha;
+    }
+    return vec4(radiance,transmission);
+}
