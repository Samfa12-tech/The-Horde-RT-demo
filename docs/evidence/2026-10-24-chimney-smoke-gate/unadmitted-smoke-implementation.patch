+    static_assert(sizeof(RtSmokeMediumGpu)==96 && alignof(RtSmokeMediumGpu)==16);
+    Check(ValidSmokeMedium(RtSmokeMediumGpu{}),"disabled medium is exactly neutral");
+    RisingSmokeProfile p;p.stableId=17;p.outlet={95.36f,.3804492f,109.28f};
+    const auto low=PackRisingSmoke(p,SmokeMediumQuality::Low);
+    const auto high=PackRisingSmoke(p,SmokeMediumQuality::High);
+    Check(low&&high,"finite bounded plume packs both explicit tiers");
+    if(low&&high) {
+        Check(low->boundsMinExtinction==high->boundsMinExtinction&&low->outletRadius==high->outletRadius&&
+              low->albedoAnisotropy==high->albedoAnisotropy&&low->identity[1]==1&&high->identity[1]==2,
+              "tiers retain physical extinction/albedo/bounds while sampling changes");
+        auto bad=*low;bad.boundsMaxReserved[0]=p.outlet[0];
+        Check(!ValidSmokeMedium(bad),"truncated drift/radius envelope rejects");
+        bad=*low;bad.identity[0]=0;Check(!ValidSmokeMedium(bad),"inactive identity cannot hide stale active fields");
+        bad=*low;bad.identity[2]=2;Check(!ValidSmokeMedium(bad),"future profile is not silently enabled");
+    }
+    p.riseSpeed=0;Check(!PackRisingSmoke(p,SmokeMediumQuality::Low),"zero rise speed rejects before division");
+    p.riseSpeed=.8f;p.outlet[0]=std::numeric_limits<float>::quiet_NaN();
