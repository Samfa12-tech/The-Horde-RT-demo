--- /dev/null
+++ b/src/vulkan/raytracing/SmokeMediumUpload.h
@@ -0,0 +1,64 @@
+#pragma once
+#include "vulkan/raytracing/RtSceneAbi.generated.h"
+#include <array>
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+namespace horde::vulkan::raytracing {
+enum class SmokeMediumQuality : unsigned { Off=0, Low=1, High=2 };
+// One declared source, not a scatter list or a new simulation owner. Motion uses
+// immutable fixed-step time; no per-frame tail upload.
+struct RisingSmokeProfile {
+    std::uint32_t stableId=0;
+    std::array<float,3> outlet{};
+    float height=7,baseRadius=.22f,upperRadius=1.65f;
+    std::array<float,2> horizontalFlow{{.12f,.08f}};
+    float riseSpeed=.8f,extinction=.45f;
+    std::array<float,3> albedo{{.72f,.74f,.76f}};
+    float anisotropy=.35f;
+};
+inline bool ValidSmokeMedium(const RtSmokeMediumGpu& m) noexcept {
+    const auto finite=[](const auto& v){return std::all_of(v.begin(),v.end(),[](float x){return std::isfinite(x);});};
+    if(!finite(m.boundsMinExtinction)||!finite(m.boundsMaxReserved)||!finite(m.outletRadius)||
+       !finite(m.flowShape)||!finite(m.albedoAnisotropy))return false;
+    if(m.identity[0]==0) return m.identity==std::array<std::uint32_t,4>{}&&
+        m.boundsMinExtinction==std::array<float,4>{}&&m.boundsMaxReserved==std::array<float,4>{}&&
+        m.outletRadius==std::array<float,4>{}&&m.flowShape==std::array<float,4>{}&&m.albedoAnisotropy==std::array<float,4>{};
+    if((m.identity[1]!=1&&m.identity[1]!=2)||m.identity[2]!=1||m.identity[3]!=0||m.boundsMaxReserved[3]!=0||
+       m.boundsMinExtinction[3]<=0||m.boundsMinExtinction[3]>2||m.outletRadius[3]<.05f||m.outletRadius[3]>2||
+       m.flowShape[2]<.1f||m.flowShape[2]>4||m.flowShape[3]<m.outletRadius[3]||m.flowShape[3]>8||
+       std::abs(m.flowShape[0])>2||std::abs(m.flowShape[1])>2||std::abs(m.albedoAnisotropy[3])>.7f)return false;
+    for(unsigned i=0;i<3;++i)if(m.albedoAnisotropy[i]<0||m.albedoAnisotropy[i]>1||
+       m.boundsMaxReserved[i]<=m.boundsMinExtinction[i]||m.boundsMaxReserved[i]-m.boundsMinExtinction[i]>32)return false;
+    const float height=m.boundsMaxReserved[1]-m.outletRadius[1];
+    if(height<=0||height>32||m.boundsMinExtinction[1]!=m.outletRadius[1])return false;
+    for(unsigned j=0;j<2;++j) {
+        const unsigned axis=j?2:0;
+        const float radius=m.flowShape[3]+std::abs(m.flowShape[j])*height/m.flowShape[2]+.35f;
+        if(m.boundsMinExtinction[axis]>m.outletRadius[axis]-radius||
+           m.boundsMaxReserved[axis]<m.outletRadius[axis]+radius)return false;
+    }
+    return true;
+}
+inline bool SameSmokeMedium(const RtSmokeMediumGpu& a,const RtSmokeMediumGpu& b) noexcept {
+    return a.boundsMinExtinction==b.boundsMinExtinction&&a.boundsMaxReserved==b.boundsMaxReserved&&
+        a.outletRadius==b.outletRadius&&a.flowShape==b.flowShape&&
+        a.albedoAnisotropy==b.albedoAnisotropy&&a.identity==b.identity;
+}
+inline std::optional<RtSmokeMediumGpu> PackRisingSmoke(const RisingSmokeProfile& p,SmokeMediumQuality quality) noexcept {
+    if(quality==SmokeMediumQuality::Off)return RtSmokeMediumGpu{};
+    if((quality!=SmokeMediumQuality::Low&&quality!=SmokeMediumQuality::High)||!p.stableId||
+       !std::isfinite(p.riseSpeed)||p.riseSpeed<=0)return std::nullopt;
+    RtSmokeMediumGpu m{};m.outletRadius={p.outlet[0],p.outlet[1],p.outlet[2],p.baseRadius};
+    m.flowShape={p.horizontalFlow[0],p.horizontalFlow[1],p.riseSpeed,p.upperRadius};
+    m.albedoAnisotropy={p.albedo[0],p.albedo[1],p.albedo[2],p.anisotropy};
+    const float rx=p.upperRadius+std::abs(p.horizontalFlow[0])*p.height/p.riseSpeed+.35f;
+    const float rz=p.upperRadius+std::abs(p.horizontalFlow[1])*p.height/p.riseSpeed+.35f;
+    m.boundsMinExtinction={p.outlet[0]-rx,p.outlet[1],p.outlet[2]-rz,p.extinction};
+    m.boundsMaxReserved={p.outlet[0]+rx,p.outlet[1]+p.height,p.outlet[2]+rz,0};
+    m.identity={p.stableId,static_cast<std::uint32_t>(quality),1,0};
+    if(!ValidSmokeMedium(m))return std::nullopt;
+    return m;
+}
+} // namespace horde::vulkan::raytracing
