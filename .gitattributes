# Keep high-resolution source art out of normal Git history.
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.rgba filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve the audited upstream cgltf bytes, including its one trailing tab.
third_party/cgltf/cgltf.h whitespace=-trailing-space

# The release identity contract is one UTF-8 line. Keep its checkout bytes
# stable even when core.autocrlf is enabled on Windows.
VERSION text eol=lf

# The pipeline catalog adapter is byte-checked during clean configure too.
src/vulkan/raytracing/RtPipelineVariantCatalog.generated.h text eol=lf

# Compute shader artifacts and their generated provenance are byte-checked.
src/vulkan/raytracing/variants/rayquery_compute_*.inc text eol=lf
src/vulkan/raytracing/RtRayQueryVariantCatalog.generated.h text eol=lf
tools/rayquery-variant-catalog.json text eol=lf

# Retained validation reports are bound to their original byte hashes.
docs/evidence/2026-09-20-lantern/** -text
docs/evidence/2026-09-20-android-route/** -text whitespace=cr-at-eol
docs/evidence/2026-09-20-lantern-abba/** -text whitespace=cr-at-eol
docs/evidence/2026-09-23-player-admission/** -text whitespace=cr-at-eol
docs/evidence/2026-09-23-viewmodel-rt/** -text whitespace=cr-at-eol
