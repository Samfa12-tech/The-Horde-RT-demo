# Keep high-resolution source art out of normal Git history.
*.glb filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.rgba filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve the audited upstream cgltf bytes, including its one trailing tab.
third_party/cgltf/cgltf.h whitespace=-trailing-space

# Soundtrack review audio stays in LFS, outside runtime packaging.
assets/source/beyond_the_tomb/music/**/*.flac filter=lfs diff=lfs merge=lfs -text
assets/source/beyond_the_tomb/music/**/*.mp3 filter=lfs diff=lfs merge=lfs -text

# Dialogue review documents remain source-only and use LFS.
docs/dialogue/en/*.docx filter=lfs diff=lfs merge=lfs -text

# CSV exporter uses RFC-style CRLF; retain exact exported bytes.
docs/dialogue/en/**/*.csv -text whitespace=cr-at-eol
docs/dialogue/en/*.csv -text whitespace=cr-at-eol
