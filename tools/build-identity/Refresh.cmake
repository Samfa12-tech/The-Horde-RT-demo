# Invoked by HordeRtBuildIdentity.cmake on every native target build. No writes
# to source/Git, no timestamps, machine paths, usernames or untracked inventory.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED ID_SPEC OR NOT DEFINED ID_OUTPUT)
    message(FATAL_ERROR "Build identity refresh requires ID_SPEC and ID_OUTPUT.")
endif()
include("${ID_SPEC}")

set(_commit "unavailable")
set(_input_state "unavailable")
set(_git_available FALSE)
if(ID_GIT AND IS_DIRECTORY "${ID_REPO_ROOT}")
    execute_process(COMMAND "${ID_GIT}" --no-optional-locks -C "${ID_REPO_ROOT}" rev-parse --verify HEAD
        RESULT_VARIABLE _git_result OUTPUT_VARIABLE _candidate ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(LENGTH "${_candidate}" _commit_length)
    if(_git_result EQUAL 0 AND _candidate MATCHES "^[0-9a-f]+$" AND
       (_commit_length EQUAL 40 OR _commit_length EQUAL 64))
        set(_commit "${_candidate}")
        set(_input_state "clean")
        set(_git_available TRUE)
    endif()
endif()

# Batch pathspecs to stay below Windows command-line limits. No external diff
# driver or optional index refresh can execute/write through these reads.
function(_horde_check_input_batch)
    if(NOT _git_available OR NOT ARGN)
        return()
    endif()
    execute_process(COMMAND "${ID_GIT}" --no-optional-locks --literal-pathspecs -c core.fsmonitor=false -C "${ID_REPO_ROOT}"
        ls-files --error-unmatch -- ${ARGN}
        RESULT_VARIABLE _tracked_result OUTPUT_QUIET ERROR_QUIET)
    execute_process(COMMAND "${ID_GIT}" --no-optional-locks --literal-pathspecs -c core.fsmonitor=false -C "${ID_REPO_ROOT}"
        diff --no-ext-diff --no-textconv --quiet "${_commit}" -- ${ARGN}
        RESULT_VARIABLE _diff_result OUTPUT_QUIET ERROR_QUIET)
    if(NOT _diff_result EQUAL 0 AND NOT _diff_result EQUAL 1)
        set(_input_state "unavailable" PARENT_SCOPE)
    elseif(NOT _tracked_result EQUAL 0 OR _diff_result EQUAL 1)
        if(NOT _input_state STREQUAL "unavailable")
            set(_input_state "dirty" PARENT_SCOPE)
        endif()
    endif()
endfunction()

set(_digest_available TRUE)
set(_fingerprint "horde-declared-native-inputs-v1\n")
set(_batch)
list(REMOVE_DUPLICATES ID_INPUTS)
list(SORT ID_INPUTS)
foreach(_input IN LISTS ID_INPUTS)
    set(_path "${ID_REPO_ROOT}/${_input}")
    file(REAL_PATH "${_path}" _resolved)
    file(RELATIVE_PATH _resolved_relative "${ID_REPO_ROOT}" "${_resolved}")
    if(_input MATCHES "(^|/)\\.\\.?(/|$)" OR IS_ABSOLUTE "${_input}" OR
       _resolved_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_resolved_relative}" OR
       NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}")
        set(_digest_available FALSE)
        set(_input_state "unavailable")
    else()
        file(SHA256 "${_path}" _file_sha)
        string(APPEND _fingerprint "file:${_input}\nsha256:${_file_sha}\n")
    endif()
    list(APPEND _batch "${_input}")
    list(LENGTH _batch _batch_length)
    if(_batch_length GREATER_EQUAL 32)
        _horde_check_input_batch(${_batch})
        set(_batch)
    endif()
endforeach()
_horde_check_input_batch(${_batch})
if(NOT ID_INPUTS)
    set(_digest_available FALSE)
    set(_input_state "unavailable")
endif()

foreach(_field IN ITEMS ID_TARGET ID_CONFIGURATION ID_COMPILER ID_SYSTEM)
    string(LENGTH "${${_field}}" _field_length)
    if("${${_field}}" STREQUAL "")
        set(${_field} "unspecified")
    elseif(NOT "${${_field}}" MATCHES "^[A-Za-z0-9_.+:-]+$" OR _field_length GREATER 96)
        set(${_field} "unavailable")
        set(_digest_available FALSE)
    endif()
    string(APPEND _fingerprint "${_field}:${${_field}}\n")
endforeach()
list(REMOVE_DUPLICATES ID_DEFINITIONS)
list(SORT ID_DEFINITIONS)
foreach(_definition IN LISTS ID_DEFINITIONS)
    if(NOT _definition MATCHES "^[A-Za-z0-9_.+-]+=[A-Za-z0-9_.+:-]+$")
        set(_digest_available FALSE)
    endif()
    string(APPEND _fingerprint "definition:${_definition}\n")
endforeach()
if(_digest_available)
    string(SHA256 _sha256 "${_fingerprint}")
else()
    set(_sha256 "unavailable")
    set(_input_state "unavailable")
endif()
set(_config_token "U")
if(ID_CONFIGURATION STREQUAL "Debug")
    set(_config_token "D")
elseif(ID_CONFIGURATION STREQUAL "Release")
    set(_config_token "R")
elseif(ID_CONFIGURATION STREQUAL "RelWithDebInfo")
    set(_config_token "RD")
elseif(ID_CONFIGURATION STREQUAL "MinSizeRel")
    set(_config_token "M")
endif()
set(_state_token "U")
if(_input_state STREQUAL "clean")
    set(_state_token "C")
elseif(_input_state STREQUAL "dirty")
    set(_state_token "D")
endif()
# The existing report field is capped at 128 bytes. SHA-256 Git repositories
# retain the full commit in sourceCommit but cannot fit that commit plus the
# full input digest in this grammar, so the compact source token is unavailable.
set(_report_commit "${_commit}")
if(_commit_length EQUAL 64)
    set(_report_commit "unavailable")
    set(_state_token "U")
endif()
set(_label "g:${_report_commit};i:${_sha256};c:${_config_token};s:${_state_token}")
set(_header "// Generated source/input provenance; NOT an artifact hash.\n#pragma once\n#define HORDE_RT_PROVENANCE_COMMIT \"${_commit}\"\n#define HORDE_RT_PROVENANCE_INPUT_STATE \"${_input_state}\"\n#define HORDE_RT_PROVENANCE_INPUT_SHA256 \"${_sha256}\"\n#define HORDE_RT_PROVENANCE_CONFIGURATION \"${ID_CONFIGURATION}\"\n#define HORDE_RT_PROVENANCE_LABEL \"${_label}\"\n")
set(_write TRUE)
if(EXISTS "${ID_OUTPUT}")
    file(READ "${ID_OUTPUT}" _old_header)
    if(_old_header STREQUAL _header)
        set(_write FALSE)
    endif()
endif()
if(_write)
    get_filename_component(_output_directory "${ID_OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${_output_directory}")
    file(WRITE "${ID_OUTPUT}.tmp" "${_header}")
    file(RENAME "${ID_OUTPUT}.tmp" "${ID_OUTPUT}")
endif()
