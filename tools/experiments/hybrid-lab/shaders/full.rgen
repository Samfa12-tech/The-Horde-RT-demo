#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(location=0) rayPayloadEXT vec4 primary;
void main() {
    vec3 d=rayDirection(vec2(gl_LaunchIDEXT.xy)+0.5),p,n;
    vec4 m;primary=vec4(-1,0,0,0);
    float projection=dot(d,pc.forward.xyz);
    traceRayEXT(scene,gl_RayFlagsOpaqueEXT,255,0,0,0,pc.camera.xyz,0.025/projection,d,50.0/projection,0);
    vec3 c=sky;
    if(primary.x>=0.0){surface(uint(primary.x),primary.yz,p,n,m);c=shade(p,n,m,d);}
    imageStore(target,ivec2(gl_LaunchIDEXT.xy),display(c));
}
