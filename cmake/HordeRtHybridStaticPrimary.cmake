option(HORDE_RT_HYBRID_STATIC_PRIMARY "Build the opt-in production static-asset hybrid experiment; full RT remains default" OFF)
set(HORDE_RT_HYBRID_STATIC_SHADER_DIR "" CACHE PATH "Explicit generated production hybrid adapter shader directory")
function(horde_rt_attach_hybrid_static_primary target_name repo_root)
 if(NOT HORDE_RT_HYBRID_STATIC_PRIMARY)
  return()
 endif()
 if(HORDE_RT_STAGED_PRIMARY_DEFAULT OR NOT "${HORDE_RT_STAGED_PRIMARY_SHADER_DIR}" STREQUAL "" OR HORDE_RT_REGION_PAGE_PROTOTYPE OR HORDE_RT_FRAME_STAGE_PROBE)
  message(FATAL_ERROR "Hybrid static-primary cannot combine with other experimental scene owners")
 endif()
 if(ANDROID)
  if(NOT HORDE_RT_ANDROID_DEFAULT_INSTRUMENTATION STREQUAL "Shipping" OR NOT HORDE_RT_ANDROID_DEFAULT_DIELECTRIC_QUALITY STREQUAL "Mobile")
   message(FATAL_ERROR "Hybrid comparison requires explicit Shipping/Mobile for both reference and candidate")
  endif()
 else()
  if(NOT HORDE_RT_INSTRUMENTATION_OVERRIDE STREQUAL "Shipping" OR NOT HORDE_RT_DIELECTRIC_QUALITY_OVERRIDE STREQUAL "Mobile")
   message(FATAL_ERROR "Hybrid comparison requires explicit Shipping/Mobile overrides for both modes")
  endif()
 endif()
 if(NOT EXISTS "${HORDE_RT_HYBRID_STATIC_SHADER_DIR}/HybridStaticPrimaryShaders.h")
  message(FATAL_ERROR "Generate/validate the explicit hybrid shader directory first")
 endif()
 target_sources(${target_name} PRIVATE "${repo_root}/src/vulkan/raytracing/experimental/HybridStaticPrimaryPass.cpp")
 target_compile_definitions(${target_name} PUBLIC HORDE_RT_HYBRID_STATIC_PRIMARY=1)
 target_include_directories(${target_name} PRIVATE "${HORDE_RT_HYBRID_STATIC_SHADER_DIR}")
 message(STATUS "EXPERIMENTAL partial static-asset hybrid enabled; full RT default; Shipping/Mobile adapters required")
endfunction()
